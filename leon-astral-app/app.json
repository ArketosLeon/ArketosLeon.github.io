{
  "expo": {
    "name": "Leon Astral",
    "slug": "arktos-leon",
    "scheme": "leonastral",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.arktosleon.leonastral",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E17"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.arktosleon.leonastral",
      "supportsTablet": false
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E17"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "arktos-leon",
          "project": "leon-astral",
          "url": "https://sentry.io/"
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#A78BFA",
          "defaultChannel": "diario"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Usamos isso para mostrar anúncios mais relevantes no plano grátis."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://rimgeohwknrwgvjburqq.supabase.co",
      "supabaseKey": "sb_publishable_hGhoAsyK38YhewKqXmy3-g_Is__vBCQ",
      "eas": {
        "projectId": "289c7243-8d34-4537-8add-5f6dba86c4fe"
      }
    },
    "owner": "arktos-leons-team"
  }
}